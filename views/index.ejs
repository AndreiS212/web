<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Videography Website</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        /* Add your additional CSS for smooth scrolling */
        html {
            scroll-behavior: smooth;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <div class="navbar">
        <a href="#home" class="navbar-link">Home</a>
        <a href="#about-us" class="navbar-link">About Us</a>
        <a href="#testimonials" class="navbar-link">Testimonials</a>
        <a href="#contact" class="navbar-link">Contact</a>
        <a href="/admin" class="navbar-link">Admin</a>
    </div>

    <!-- Home Section -->
    <section id="home">
        <h1>Luca's Frames</h1>
        <h2>Storyteller</h2>
        <div class="video-container">
            <% videos.forEach(video => { %>
                <div class="video-item">
                    <h3><%= video.title %></h3>
                    <img src="<%= video.thumbnail %>" onclick="playVideo('<%= video.url %>')">
                </div>
            <% }) %>
        </div>
    </section>

    <!-- About Us Section -->
    <section id="about-us">
        <h2>About Us</h2>
        <p>Learn more about our videography services and team.</p>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials">
        <h2>What Our Clients Say</h2>
        <div class="reviews-container">
            <% for (var i = 0; i < 5; i++) { %>
                <div class="review-container" style="width: 250px; height: 300px;">
                    <h3>Review <%= i + 1 %></h3>
                    <!-- 
                      TO DO: Replace this with actual review data from Trustpilot API
                      const reviewData = [
                        {
                          text: "This is a great service!",
                          rating: 5,
                          author: "John Doe"
                        },
                        {
                          text: "I'm so happy with the results!",
                          rating: 5,
                          author: "Jane Smith"
                        },
                        {
                          text: "Excellent customer service!",
                          rating: 5,
                          author: "Bob Johnson"
                        },
                        {
                          text: "I highly recommend this company!",
                          rating: 5,
                          author: "Alice Brown"
                        },
                        {
                          text: "Great value for the price!",
                          rating: 4,
                          author: "Mike Davis"
                        }
                      ];
                    -->
                    <p id="review-<%= i %>" style="font-size: 14px;"></p>
                </div>
            <% } %>
        </div>
    </section>

    <script>
        // TO DO: Replace this with actual API call to Trustpilot
        // const reviewData = [...]; // fetch from API
        const reviewData = [
            {
                text: "This is a great service!",
                rating: 5,
                author: "John Doe"
            },
            {
                text: "I'm so happy with the results!",
                rating: 5,
                author: "Jane Smith"
            },
            {
                text: "Excellent customer service!",
                rating: 5,
                author: "Bob Johnson"
            },
            {
                text: "I highly recommend this company!",
                rating: 5,
                author: "Alice Brown"
            },
            {
                text: "Great value for the price!",
                rating: 4,
                author: "Mike Davis"
            }
        ];

        reviewData.forEach((review, index) => {
            const reviewHtml = `
              <p>${review.text}</p>
              <p>Rating: ${review.rating}/5</p>
              <p>Author: ${review.author}</p>
            `;
            document.getElementById(`review-${index}`).innerHTML = reviewHtml;
        });
    </script>

    <!-- Contact Section -->
    <section id="contact">
        <h2>Contact Us</h2>
        <p>If you have any questions or want to book our services, feel free to reach out to us.</p>
        <div class="contact-container">
            <div class="contact-info">
                <h3>Get in Touch</h3>
                <p>Phone: 555-555-5555</p>
                <p>Email: [info@example.com](mailto:info@example.com)</p>
                <p>Address:</p>
            </div>
        </div